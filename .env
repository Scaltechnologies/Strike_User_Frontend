EXPO_PUBLIC_API_BASE_URL=https://api.strikeapp.in

# Google Places API (New) key for Set Location search — see
# src/services/googlePlacesService.ts and the Google integration report for
# Cloud Console setup. Left blank on purpose: this file is committed to git,
# and a real key belongs in .env.local (already git-ignored) or an EAS
# environment variable/secret for CI/production builds, not here.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
# Optional — only needed if the above key has an Android application
# restriction configured in Cloud Console. See src/config/env.ts.
EXPO_PUBLIC_GOOGLE_ANDROID_CERT_SHA1=

# Google Maps SDK key for the "Pick on map" screen (react-native-maps) — a
# DIFFERENT concern from the Places key above: this one is read by
# app.config.js at prebuild time (Node process, not the JS bundle) and baked
# into the native Android/iOS project, so it deliberately has no EXPO_PUBLIC_
# prefix. Requires "Maps SDK for Android" and "Maps SDK for iOS" enabled in
# Cloud Console, and a new native build after setting it (JS reload isn't
# enough). Same rule as above: put the real value in .env.local, not here.
GOOGLE_MAPS_API_KEY=